  {
    "id": "toMap",
    "type": "function",
    "name": "Tracker + fence",
    "func": "// Tracker marker + fence circle for the world map; node status shows GPS + fence state.\nconst d = msg.payload;\nflow.set(\"lastLoc\", d);\nnode.status({\n    fill: d.status === \"FIX\" ? \"green\" : (d.status === \"SLEEP\" ? \"blue\" : \"yellow\"),\n    shape: d.find ? \"ring\" : \"dot\",\n    text: `${d.status || \"?\"} | sats ${d.sats ?? \"?\"} | ${d.fence || \"\"}${d.find ? \" | FIND\" : \"\"}`\n});\nconst out = [];\nif (d.lat !== null && d.lon !== null) {\n    out.push({ payload: {\n        name: \"Tracker\", lat: d.lat, lon: d.lon, icon: \"fa-crosshairs\",\n        iconColor: d.status === \"FIX\" ? \"green\" : \"orange\",\n        status: d.status, sats: d.sats, fence: d.fence, find: d.find\n    }});\n}\nif (d.fence_r !== null && d.fence_lat !== null) {\n    out.push({ payload: { name: \"Fence\", lat: d.fence_lat, lon: d.fence_lon, radius: d.fence_r,\n        icon: \"fa-circle-o\", iconColor: \"red\", color: \"#d33\", fillColor: \"#d33\", fillOpacity: 0.1 } });\n    context.set(\"fenceShown\", true);\n} else if (context.get(\"fenceShown\")) {\n    out.push({ payload: { name: \"Fence\", deleted: true } });\n    context.set(\"fenceShown\", false);\n}\nreturn [out];",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 680,
    "y": 60,
    "wires": [
      [
        "worldmap"
      ]
    ],
    "z": "gpsTab"
  },
  {
    "id": "alertToMap",
    "type": "function",
    "name": "Alert markers",
    "func": "// Drop a red marker where each \"left the fence\" alert happened.\nconst a = msg.payload;\nif (a.event !== \"exit\" || a.lat === null || a.lon === null) return null;\nconst n = (context.get(\"count\") || 0) + 1;\ncontext.set(\"count\", n);\nmsg.payload = { name: \"Alert \" + n, lat: a.lat, lon: a.lon, icon: \"fa-exclamation-triangle\",\n    iconColor: \"red\", alert: a.msg, time: new Date().toLocaleTimeString() };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 680,
    "y": 120,
    "wires": [
      [
        "worldmap"
      ]
    ],
    "z": "gpsTab"
  },
