  {
    "id": "fenceHere",
    "type": "function",
    "name": "Fence at tracker",
    "func": "// Fence centred on the tracker's latest position. Change the radius below (metres, >= 20).\nconst radius = 50;\nconst d = flow.get(\"lastLoc\");\nif (!d || d.lat === null || d.lon === null) {\n    node.warn(\"No tracker position yet\");\n    return null;\n}\nmsg.payload = `fence ${d.lat.toFixed(6)},${d.lon.toFixed(6)},${radius}`;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
